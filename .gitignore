# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
.mypy_cache/
.pytest_cache/
.pytest_tmp*/
.pytest_verify_tmp/
_pytest_basetemp_*/
.tmp/
.ruff_cache/
.uv-cache/
.coverage
dist/
build/

# Local environments and editor state
.env
*.env
.venv/
.venv-*/
venv/
venvs/
.idea/
.vscode/

# Config overrides (constitution §7.1 layered config; never versioned)
config.override.toml
my_config*.toml
config.local.toml
*.local.toml

# AI assistant files (generated on demand, not versioned)
CLAUDE.md
CLAUDE.zh-CN.md
AGENTS.md
work_log.md
work_log_*.md

# OS files
.DS_Store
Thumbs.db
# Windows Mark-of-the-Web alternate data streams materialized as files
*:Zone.Identifier

# Local notes, credentials, runbooks, and ad hoc files
.local/

# Training outputs and experiment artifacts
outputs/
checkpoints/
anchor_bank/
wandb/
runs/
logs/
reports/
experiment_data/
*.log

# Large model and checkpoint files (repo root only)
/models/
*.safetensors
*.bin
*.pt
*.pth
*.tar.gz
*.tar

# Prevent accidental recreation of old data/config directories at root
/data/
/configs/
/config_example.yaml

# Sample data and configs live in samples/ (tracked);
# production data belongs outside the repository.
*.xlsx
*.xls
.dataset/
.datasets/
*.bak
