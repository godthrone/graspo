# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
.mypy_cache/
.pytest_cache/
.pytest_tmp*/
.pytest_verify_tmp/
_pytest_basetemp_*/
.tmp/
.ruff_cache/
.uv-cache/
.coverage
dist/
build/

# Local environments and editor state
.env
*.env
.venv/
.venv-*/
venv/
venvs/
.idea/
.vscode/

# Config overrides (constitution §7.1 layered config; never versioned)
config.override.toml
my_config*.toml
config.local.toml
*.local.toml

# AI assistant files (generated on demand, not versioned)
CLAUDE.md
CLAUDE.zh-CN.md
AGENTS.md
work_log.md
work_log_*.md

# OS files
.DS_Store
Thumbs.db
# Windows Mark-of-the-Web alternate data streams materialized as files
*:Zone.Identifier

# Local notes, credentials, runbooks, and ad hoc files
.local/

# Training outputs and experiment artifacts
outputs/
checkpoints/
anchor_bank/
wandb/
runs/
logs/
reports/
experiment_data/
*.log

# Large model and checkpoint files (repo root only)
/models/
*.safetensors
*.bin
*.pt
*.pth
*.tar.gz
*.tar

# Prevent accidental recreation of old data/config directories at root
/data/
/configs/
/config_example.yaml

# Sample data and configs live in samples/ (tracked);
# production data belongs outside the repository.
*.xlsx
*.xls
.dataset/
.datasets/
*.bak
# ★ 口径变更前的成对备份（形如 `*.bak-before-caliber-YYYYMMDD`）：`*.bak` **不覆盖**它，
#   曾被 `git status -uall` 报成残留未跟踪件（修正轮 1 W1）⇒ 显式忽略。
#   备份本体移入 `.local/`（`.local/` 已整体忽略），本行是第二道兜底。
*.bak-before-*

# ★ 变异测试的临时副本：`test_run_matrix54_runner.py` 的负向（突变）用例会把 runner 的变异副本
#   写进 `tests/e2e/`（**必须**与 runner 同级 —— 它用 `dirname($0)/../..` 反推仓库根 `ROOT_DIR`，
#   挪去 tmp_path 会让守卫脚本与挂载源指向错处）。用例内由 autouse fixture 保证删除，
#   但**进程被 SIGKILL 时不会执行** ⇒ 这里兜底忽略：泄漏的副本不得进入口门禁候选集
#   （候选集 = `git ls-files` ∪ `--others --exclude-standard`）。
tests/e2e/_mutant_*.sh
