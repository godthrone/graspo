# GRASPO 实验镜像（**派生版**）—— 在既有矩阵镜像上「只加」ms-swift 非有限梯度逐步计数。
#
# 目的：给判据③（跨全部 rank 的非有限跳过计数 = 0）补上**可读证据**，
#       **只加证据、不改训练语义**（详见 mixin.py.patch 与报告）。
#
# 为什么用派生镜像（而非从头重建）：
#   · 基座 = 已冻结并全程用于 r1/r2/r3 的矩阵镜像 `graspo:v0.28.11-cu130fix-v2-20260923`
#     （Image ID `4a7a9e0d336d…`，其 sha256 已记入 matrix54 manifest 快照）；
#   · 派生 ⇒ **除 `mixin.py` 外所有层逐字节相同**，这本身就是「未动其它东西」的结构性证据；
#   · 成本 O(1)（秒级），不需要重下 8GB base、不触碰任何网络/代理。
#
# 构建（在 228，构建上下文只含本目录三个文件，**不写 228 仓库树**）：
#   docker build -t graspo:v0.28.11-cu130fix-v2-nfc1 -f Dockerfile.msswift.nfc <context>
FROM graspo:v0.28.11-cu130fix-v2-20260923

COPY apply_nonfinite_grad_count.py /tmp/apply_nonfinite_grad_count.py
COPY mixin.py.patched /tmp/mixin.py.patched

RUN set -eux; \
    python3 /tmp/apply_nonfinite_grad_count.py; \
    python3 -c "import swift, torch; print('swift', swift.__version__, '| torch', torch.__version__)"; \
    python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/usr/local/lib/python3.12/dist-packages/swift/trainers/mixin.py').read_text()); print('SYNTAX OK')"; \
    python3 -c "import pathlib; t=pathlib.Path('/usr/local/lib/python3.12/dist-packages/swift/trainers/mixin.py').read_text(); assert \"logs['nonfinite_grad_step_count']\" in t; print('MARKERS OK')"; \
    rm -f /tmp/apply_nonfinite_grad_count.py /tmp/mixin.py.patched; \
    echo "NFC PATCH OK"

# 原始备份保留在镜像内（可事后 diff 复原），不删。
LABEL graspo.image.role="matrix54-rerun-candidate" \
      graspo.patch.name="msswift-nonfinite-grad-step-count" \
      graspo.patch.version="1" \
      graspo.base.image="graspo:v0.28.11-cu130fix-v2-20260923" \
      graspo.base.image_id="sha256:4a7a9e0d336dcd53546509b88550f0540a602819e95b2ae27cd4b94c4a410fd6" \
      graspo.mixin.path="/usr/local/lib/python3.12/dist-packages/swift/trainers/mixin.py" \
      graspo.mixin.sha256.orig="ade47c48a1c555c73d756ae1c8a4e9cdf937c7f03c8c54dd7aa53ce51a9105c2" \
      graspo.mixin.sha256.patched="93f61f7258f0bd561ace53c1d1cc787e077c5de1247b6f6c0906266341f9a713" \
      graspo.log.keys="nonfinite_grad_step_count,nonfinite_grad_step_count_coverage"
