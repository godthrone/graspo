# GRASPO 实验镜像配方（ms-swift 路径）—— 公开 base + cu130 官方索引 + 精确 pin。
#
# 用途：给"本期 54 档实测"提供**可公开复现**的执行环境配方（与产品镜像同一套版本 pin，
# 额外含 ms-swift 与 pytest）。**本期唯一获批执行环境是既有的实验镜像**
# `graspo-msswift:4.5.3`；本配方是该环境的公开等价配方，其实际来源记录在
# `.local/`（环境信息，不入 tracked 文件，宪法 §16）。
#
# ⚠️ 状态：**待上机验证**（不阻塞本期）。只读边界内无法确证 `download.pytorch.org`
#    从构建机可达，也未起容器实测，故本配方尚未定稿。验证命令（单一路径锁卡）：
#      python3 scripts/gpu_lock_guard.py --visible 0 || exit 1
#      docker run --rm --runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=0 <image> \
#        python -c "import swift, torch; print(swift.__version__, torch.__version__, torch.version.cuda)"
#
# 构建（版本号唯一来源是 docker/build.sh，见 §1.4）：
#   DOCKERFILE=docker/Dockerfile.msswift IMAGE_NAME=graspo-msswift:4.5.3 bash docker/build.sh
#
# 代理与 pip 源：**只构建时需要、运行时不需要** ⇒ 一律用 ARG，禁止写入 ENV（§7.1）。

# 公开 base：pytorch/pytorch，digest 精确锁定。
FROM pytorch/pytorch@sha256:91629be68c98490a987b243b176757e8549336b98296933448fe496427118569

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG PIP_INDEX_URL=https://pypi.org/simple/

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    && apt-get update -o Acquire::Retries=10 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=10 -o Acquire::http::Timeout=30 \
    git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/graspo

# ── 运行时依赖：精确 pin（宪法 §6）────────────────────────────────────────────
# 锁定值 = 实测血统；与 pyproject.toml 的声明由 scripts/check_env_versions.py
# 自动派生包集合并逐包比对（§2 防呆）。
COPY pyproject.toml uv.lock .python-version README.md LICENSE ./

# 不用 BuildKit 缓存挂载：构建机没有 buildx 组件，`RUN --mount=type=cache` 会直接
# 报 "the --mount option requires BuildKit" 而中断。那三处只是 pip 缓存加速，去掉
# 不改变产物内容（`--no-cache-dir` 本来就不落 pip 缓存）。
# `--break-system-packages`：base 是 Ubuntu 24.04 系统 Python（PEP 668
# `/usr/lib/python3.12/EXTERNALLY-MANAGED`），不加会被 pip 拒绝安装。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${TORCH_INDEX_URL}" \
    torch==2.11.0 torchvision==0.26.0

RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    transformers==5.12.1 pydantic==2.11.10 pyyaml==6.0.3 safetensors==0.8.0 \
    pillow==11.3.0 numpy==1.26.4 ms-swift==4.5.3 pytest==9.0.3

# CUDA 渠道断言（fail-closed）。
RUN python -c "import torch, sys; cuda=torch.version.cuda or ''; print('torch', torch.__version__, 'cuda', cuda); sys.exit('CUDA CHANNEL FAILED: '+cuda) if not cuda.startswith('13.0') else None"

# ── 源码 + 项目安装 ──────────────────────────────────────────────────────────
COPY src ./src
COPY samples ./samples
COPY scripts/check_env_versions.py ./scripts/check_env_versions.py
COPY docker/Dockerfile.msswift ./docker/Dockerfile.msswift
COPY docker/Dockerfile ./docker/Dockerfile

ARG VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${VERSION}
# 代码单向流动（§14.4）追溯锚点 + 实测版本记录。
RUN mkdir -p /opt/graspo-image \
    && printf '%s\n' "${VERSION}" > /opt/graspo-image/VERSION \
    && python -c "import swift, torch, transformers, pydantic; print('ms-swift', swift.__version__); print('torch', torch.__version__); print('transformers', transformers.__version__); print('pydantic', pydantic.VERSION)" >> /opt/graspo-image/VERSION

# ── 项目安装 + 构建期版本门禁（fail-closed）──────────────────────────────────
# 门禁脚本按自身路径推导 PROJECT_ROOT=/workspace/graspo，能读到 pyproject 与两个 Dockerfile。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${PIP_INDEX_URL}" uv \
    && uv pip install --system --break-system-packages --no-deps -e . \
    && python scripts/check_env_versions.py --local

# ── 运行时依赖补遗（不在 pyproject pin 内，但 ms-swift / 矩阵档位需要）─────────────
# 背景：`ms-swift==4.5.3` 自身**不声明**下列包（其 89 条 requires_dist 里没有
# qwen/decord/av/librosa/soundfile 任何一条）——旧镜像是手工补装的，本配方此前漏了，
# 导致 VL 档训练启动即崩（`PackageNotFoundError: Package metadata was not found for qwen_vl_utils`）。
# 只增不改：本段新增在既有 pip 层之后，不动前面任何一行 ⇒ 前 14 步层缓存全部命中。
# 分层安装：每层独立 RUN，便于某层失败时前面的层仍可复用。
#
# 第 1 层：多模态 / 音视频 / 图像运行时（36 个 VL 档必需）。
#   torchaudio 走 cu130 官方索引，与既有 torch 同源同版本。
#   numba/llvmlite/msgpack/… 是 librosa 的传递依赖，同时显式 pin 以固定版本、避免解析漂移。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    "qwen-vl-utils==0.0.14" "qwen-omni-utils==0.0.9" "decord==0.6.0" "av==17.1.0" \
    "librosa==0.11.0" "soundfile==0.13.1" "timm==1.0.27" "opencv-python==4.11.0.86" \
    "diffusers==0.38.0" \
    "numba==0.65.0" "llvmlite==0.47.0" "scikit-learn==1.9.0" "pooch==1.9.0" "soxr==1.1.0" \
    "lazy_loader==0.5" "audioread==3.1.0" "msgpack==1.2.1" "platformdirs==4.10.0" \
    "narwhals==2.22.1" "threadpoolctl==3.6.0" \
    && pip install --break-system-packages --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cu130 "torchaudio==2.11.0"

# 第 2 层：24 个 zero2 / zero2_offload 档需要 deepspeed。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    "deepspeed==0.18.9"

# 第 3 层：RL 档（GRASPO/OPD）需要 vllm + ray。
#
# ⚠ 必须 `--no-deps`（= 复刻旧镜像 `graspo-msswift:4.5.3` 的真实组合）：
#   `vllm==0.23.0` 声明 `transformers>=4.56.0`（看似允许 5.12.1），但它同时要求
#   `huggingface-hub<1.0`，而 transformers 5.12.1 需要 huggingface-hub 1.x —— 两者
#   不可同时满足。让 pip 参与解析会**降级** transformers 5.12.1→4.57.6、hub 1.32→0.36，
#   直接打破 `pyproject.toml` 的 pin 与构建期版本门禁。
#   旧镜像里同时存在 vllm 0.23.0 + transformers 5.12.1 + hub 1.2x，说明当初也是绕过解析装的，
#   且该组合在 228 上真跑通过 GRASPO 档 ⇒ 本层照此办理，项目 pin 一个都不动。
#   下列额外包由 scratch 探针逐一验证得出（"import vllm / vllm --version / import ray"
#   所需的最小集合），版本对齐旧镜像。
#   注意：`--no-deps` 只跳过依赖解析，**不改变索引解析** ⇒ cu130 版 torchaudio 必须单独
#   用 cu130 索引安装（已在第 1 层完成，故此处不重复）。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --no-deps \
    --index-url "${PIP_INDEX_URL}" \
    "vllm==0.23.0" "ray==2.55.1" \
    "cachetools==7.1.4" "blake3==1.0.9" "py-cpuinfo==9.0.0" "prometheus_client==0.25.0" \
    "prometheus-fastapi-instrumentator==8.0.2" "lm-format-enforcer==0.11.3" "llguidance==1.7.6" \
    "outlines_core==0.2.14" "diskcache==5.6.3" "lark==1.2.2" "xgrammar==0.2.3" \
    "partial-json-parser==0.2.1.1.post7" "pyzmq==27.1.0" "msgspec==0.21.1" "gguf==0.19.0" \
    "mistral_common==1.11.5" "compressed-tensors==0.17.0" "depyf==0.20.0" "watchfiles==1.2.0" \
    "python-json-logger==4.1.0" "pybase64==1.4.3" "cbor2==6.1.2" "ijson==3.5.0" \
    "setproctitle==1.3.7" "openai-harmony==0.0.8" "anthropic==0.112.0" \
    "model-hosting-container-standards==0.1.16" "mcp==1.28.1" \
    "opentelemetry-sdk==1.43.0" "opentelemetry-api==1.43.0" \
    "opentelemetry-exporter-otlp==1.43.0" "opentelemetry-semantic-conventions-ai==0.5.1" \
    "flashinfer-python==0.6.12" "flashinfer-cubin==0.6.12" "apache-tvm-ffi==0.1.9" \
    "tilelang==0.1.9" "nvidia-cudnn-frontend==1.25.0" "fastsafetensors==0.3.2" \
    "nvidia-cutlass-dsl==4.5.2" "quack-kernels==0.5.0" "tokenspeed-mla==0.1.2" \
    "humming-kernels==0.1.4" \
    "msgpack==1.2.1" "jsonschema==4.26.0" "referencing==0.37.0" "rpds-py==2026.5.1" \
    "jsonschema-specifications==2025.9.1" "pydantic-extra-types==2.11.1" "pycountry==26.2.16" \
    "uvloop==0.22.1" "opencv-python-headless==4.13.0.92"

# 第 3 层断言（fail-closed）：vllm/ray 必须真正可 import，且**不得**改动 transformers/hub。
# 在构建期暴露问题，而不是等跑矩阵时才发现。
RUN python -c "import msgpack, jsonschema, ray, vllm, cv2, uvloop; import transformers, huggingface_hub as hub; assert transformers.__version__.startswith('5.12.1'), transformers.__version__; assert hub.__version__.startswith('1.'), hub.__version__; print('RL DEPS OK', 'vllm', vllm.__version__, '| ray', ray.__version__, '| transformers', transformers.__version__, '| hf-hub', hub.__version__)"
RUN vllm --version && ray --version

# 第 4 层：内核 / 并行后端（独立成层，便于失败时单独回退）。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    "liger_kernel==0.8.0" "flash-linear-attention==0.5.1" \
    "megatron-core==0.17.1" "mcore_bridge==1.5.2"

# ── 第 5 层：系统共享库（apt）—— 修真实崩溃根因 ────────────────────────────────
# 真实报错链（跑批执行者抓到的完整调用栈，r6 镜像上 T014 ~20s rc=1）：
#   swift qwen.py:1676 → transformers Qwen3_5ForConditionalGeneration
#     → transformers/models/qwen3_5/modeling_qwen3_5.py:73 → from fla.ops.gated_delta_rule import …
#     → fla/ops/common/backends/tilelang/__init__.py:30 → import tilelang
#     → tilelang/3rdparty/tvm/python/tvm/base.py:45 → ctypes.CDLL("libz3.so")
#     ⇒ OSError: libz3.so: cannot open shared object file
# 影响面 = **全部 49 档**（transformers 的 Qwen3_5 建模自己 `import fla`，native 与 ms-swift 同等受害）。
# 关键点：**`pip install z3-solver` 无效** —— 它的 `libz3.so` 落在 site-packages 内，
#   动态加载器按 `ctypes.CDLL("libz3.so")` 找不到，除非注入 `LD_LIBRARY_PATH`；
#   而 runner 是生成物、不接受额外 env/挂载 ⇒ **必须在镜像里装系统库**。
# 旧镜像 `graspo-msswift:4.5.3` 的做法就是 apt 装 `libz3-4` + `libz3-dev`
#   （`/usr/lib/x86_64-linux-gnu/libz3.so -> libz3.so.4`，实测 dpkg 为 4.8.12-1）。
# 本层同时对齐旧镜像的其它共享库：libsm6 / libice6 / libsndfile1 / libmlx5-1。
# apt 走 228 默认源（实测 archive.ubuntu.com 可达 200）；代理按既有 ARG 传入。
# 注意：本层虽在第 4 层之后，但 apt 层会使其后所有层重算 —— 这是必要的，因为
#   libz3.so 必须在**最终镜像**里存在；前面的 pip 层（25/26/27/30）不受影响，仍命中缓存。
RUN export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    && apt-get update -o Acquire::Retries=10 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=10 -o Acquire::http::Timeout=30 \
    libz3-4 libz3-dev libsm6 libice6 libsndfile1 libmlx5-1 \
    && rm -rf /var/lib/apt/lists/*

# 第 5 层断言（fail-closed）：用**真实报错链**验证，而不是只 import z3。
#   `tilelang → tvm → ctypes.CDLL("libz3.so")` 这条链必须能跑通；
#   同时验证 ldconfig 能看到 libz3/libSM/libICE/libsndfile/libmlx5。
RUN python -c "import tilelang, fla; from transformers import Qwen3_5ForConditionalGeneration; print('DEPS_OK')"
RUN bash -c 'ldconfig -p | grep -E "libz3|libSM|libICE|libsndfile|libmlx5" || (echo "SHARED LIBS MISSING" && exit 1)'

# ── 第 6 层：补齐"已声明但缺装"的 Python 直接依赖（关掉 pip check 缺口）────────
# 背景：第 3 层用 `--no-deps` 复刻旧镜像组合，代价是凡被 vllm/ray/内核后端声明、
#       而此前各层没装的**直接依赖**都缺位；`pip check` 因此报 33 条。
# 本层把这些一次性补齐（版本对齐旧镜像 `graspo-msswift:4.5.3`），仍用 `--no-deps`
#       以免引入新的解析漂移（这些包与现网 pin 在旧镜像中共存已验证）。
RUN \
    HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" \
    http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" \
    pip install --break-system-packages --no-cache-dir --no-deps \
    --index-url "${PIP_INDEX_URL}" \
    "z3-solver==4.15.4.0" \
    "nvidia-ml-py==13.595.45" "pyelftools==0.33" "tabulate==0.10.0" \
    "astor==0.8.1" "supervisor==4.3.0" "interegular==0.3.3" \
    "loguru==0.7.3" "distro==1.9.0" "docstring_parser==0.18.0" \
    "pydantic-settings==2.14.2" "python-dotenv==1.2.2" "PyJWT==2.13.0" \
    "httpx-sse==0.4.3" "python-multipart==0.0.32" "sse-starlette==3.4.5" \
    "ml_dtypes==0.5.4" "opentelemetry-semantic-conventions==0.64b0" \
    "opentelemetry-proto==1.43.0" "opentelemetry-exporter-otlp-proto-common==1.43.0" \
    "opentelemetry-exporter-otlp-proto-grpc==1.43.0" \
    "opentelemetry-exporter-otlp-proto-http==1.43.0" \
    "googleapis-common-protos==1.75.0" \
    "cuda-tile==1.3.0" "nvidia-cutlass-dsl-libs-base==4.5.2" \
    "torch_c_dlpack_ext==0.1.5" "tokenspeed-triton==3.7.10.post20260531"

RUN python -c "import z3, docstring_parser, distro, loguru, pydantic_settings, dotenv, jwt, multipart, sse_starlette, ml_dtypes; print('GAP DEPS OK')"

# 构建期存活性验证（fail-closed）：只 import 不需要 GPU 的模块；
# deepspeed/vllm/ray 等需要 CUDA 初始化，仅断言发行版元数据存在。
# 末尾重跑版本门禁，证明补遗未破坏既有 pin。
RUN python - <<'PY'
import importlib.metadata as md
import importlib.util as iu
import traceback

# 需要 GPU 或重初始化，构建期不 import
metadata_only = [
    "qwen-vl-utils", "qwen-omni-utils", "decord", "av", "librosa", "soundfile",
    "timm", "opencv-python", "diffusers", "torchaudio", "deepspeed",
    "liger-kernel", "flash-linear-attention", "megatron-core", "mcore-bridge",
    # 第 5/6 层补齐的"已声明但缺装"依赖（无顶层模块或构建期不宜 import 的）
    "cuda-tile", "nvidia-cutlass-dsl-libs-base", "torch-c-dlpack-ext",
    "tokenspeed-triton", "opentelemetry-semantic-conventions",
    "opentelemetry-proto", "opentelemetry-exporter-otlp-proto-common",
    "opentelemetry-exporter-otlp-proto-grpc", "opentelemetry-exporter-otlp-proto-http",
    "googleapis-common-protos",
    "nvidia-ml-py", "pyelftools", "tabulate", "astor", "supervisor", "interegular",
    # 第 5 层 apt 系统库对应的 Python 侧依赖（tilelang/tvm 链）
    "tilelang", "flash-linear-attention", "z3-solver",
]
importable = [
    ("qwen_vl_utils", "qwen-vl-utils"),
    ("qwen_omni_utils", "qwen-omni-utils"),
    ("decord", "decord"),
    ("av", "av"),
    ("librosa", "librosa"),
    ("soundfile", "soundfile"),
    ("torchaudio", "torchaudio"),
    ("timm", "timm"),
    ("cv2", "opencv-python"),
    ("diffusers", "diffusers"),
    # 探针已验证 vllm / ray 可在本镜像（无 GPU 上下文）import 成功
    ("vllm", "vllm"),
    ("ray", "ray"),
    # 真实崩溃链：tilelang → tvm → ctypes.CDLL("libz3.so")；以及 Qwen3_5 建模自己 import fla
    ("tilelang", "tilelang"),
    ("fla", "flash-linear-attention"),
    ("z3", "z3-solver"),
    # 第 6 层补齐的缺口
    ("docstring_parser", "docstring-parser"),
    ("distro", "distro"),
    ("loguru", "loguru"),
    ("pydantic_settings", "pydantic-settings"),
    ("dotenv", "python-dotenv"),
    ("jwt", "PyJWT"),
    ("multipart", "python-multipart"),
    ("sse_starlette", "sse-starlette"),
    ("ml_dtypes", "ml-dtypes"),
]

# 真实链条断言：transformers 的 Qwen3_5 建模 → fla → tilelang → tvm → libz3.so
Qwen3_5_IMPORT = "from transformers import Qwen3_5ForConditionalGeneration"
REQUIRED_SO = ("libz3.so", "libz3.so.4", "libSM.so.6", "libICE.so.6",
               "libsndfile.so.1", "libmlx5.so.1")

# 版本守卫：`--no-deps` 装 vllm 的前提是它**不能**改动这两个包。
EXPECTED_PREFIX = {"transformers": "5.12.1", "huggingface-hub": "1."}

problems = []
for dist in metadata_only:
    try:
        print("OK  dist  %-26s %s" % (dist, md.version(dist)))
    except Exception as exc:
        problems.append("metadata %s: %r" % (dist, exc))
        print("FAIL dist  %-26s %r" % (dist, exc))

for mod, dist in importable:
    if iu.find_spec(mod) is None:
        problems.append("import %s (dist %s): module not found" % (mod, dist))
        print("FAIL import %-18s (dist %s)" % (mod, dist))
        continue
    try:
        __import__(mod)
        print("OK  import %-18s (dist %s)" % (mod, dist))
    except Exception as exc:
        problems.append("import %s (dist %s): %r" % (mod, dist, exc))
        print("FAIL import %-18s (dist %s): %r" % (mod, dist, exc))
        traceback.print_exc()

if problems:
    raise SystemExit("MM DEP CHECK FAILED:\n  " + "\n  ".join(problems))

for dist, prefix in EXPECTED_PREFIX.items():
    got = md.version(dist)
    if not got.startswith(prefix):
        problems.append("version guard %s: expected prefix %r, got %r" % (dist, prefix, got))
        print("FAIL guard %-18s expected %s*, got %s" % (dist, prefix, got))
    else:
        print("OK  guard %-18s %s" % (dist, got))

# 共享库守卫：ldconfig 必须能看到 T014 崩溃链所需的那几个 .so
try:
    import ctypes.util as cu
    ldout = __import__("subprocess").run(["ldconfig", "-p"], capture_output=True, text=True).stdout
    for so in REQUIRED_SO:
        if so in ldout:
            print("OK  lib     %s" % so)
        else:
            problems.append("shared lib missing: %s" % so)
            print("FAIL lib     %s (not in ldconfig -p)" % so)
except Exception as exc:
    problems.append("ldconfig check failed: %r" % (exc,))
    print("FAIL lib check %r" % (exc,))

# 真实崩溃链守卫（子进程跑，避免 import 副作用污染本进程）：
#   transformers Qwen3_5 建模 → fla → tilelang → tvm → ctypes.CDLL("libz3.so")
try:
    r = __import__("subprocess").run(
        ["python", "-c", "import tilelang, fla; " + Qwen3_5_IMPORT + "; print('DEPS_OK')"],
        capture_output=True, text=True, timeout=600)
    if r.returncode == 0 and "DEPS_OK" in r.stdout:
        print("OK  chain   tilelang+fla+Qwen3_5ForConditionalGeneration -> DEPS_OK")
    else:
        problems.append("real chain failed rc=%s: %s" % (r.returncode, (r.stderr or "")[-500:]))
        print("FAIL chain   rc=%s stderr_tail=%s" % (r.returncode, (r.stderr or "")[-300:]))
except Exception as exc:
    problems.append("real chain check failed: %r" % (exc,))
    print("FAIL chain   %r" % (exc,))

if problems:
    raise SystemExit("MM DEP CHECK FAILED:\n  " + "\n  ".join(problems))
print("MM DEPS OK (all runtime deps present; libz3 chain OK; transformers/hf-hub pins intact)")
PY

RUN python scripts/check_env_versions.py --local

CMD ["bash"]
